(defn normalize-locale [value]
  (let [value (str/replace (or value "") "_" "-")
        lower (str/lower-case value)]
    (cond
      (str/starts-with? lower "ko") "ko"
      (str/starts-with? lower "ja") "ja"
      (str/starts-with? lower "zh") "zh-Hans"
      :else "en")))

(defn initial-locale []
  (or (some-> (.getItem js/localStorage "slopbook.locale") normalize-locale)
      (normalize-locale (.-language js/navigator))))

(defn t
  ([locale key] (t locale key nil))
  ([locale key replacements]
   (let [index (get locale-index (normalize-locale locale) 0)
         template (or (get-in messages [key index]) (name key))]
     (reduce-kv (fn [value token replacement]
                  (str/replace value (str "{" (name token) "}") (str replacement)))
                template (or replacements {})))))

(defn catalog-label [locale choice]
  (if-let [custom (:custom_label choice)]
    custom
    (let [id (or (:id choice) "")
          index (get locale-index (normalize-locale locale) 0)]
      (or (get-in catalog-labels [id index])
          (-> id (str/replace "_" " ") str/capitalize)))))

(defn error-text [locale error]
  (let [key (keyword (str "error." (or (:code error) "UNKNOWN")))]
    (if (contains? messages key)
      (t locale key)
      (t locale :common.error))))

(defn time-ago [locale timestamp]
  (try
    (let [date (js/Date. timestamp)
          seconds (js/Math.round (/ (- (.getTime date) (.now js/Date)) 1000))
          absolute (js/Math.abs seconds)
          [amount unit] (cond
                          (< absolute 60) [seconds "second"]
                          (< absolute 3600) [(js/Math.round (/ seconds 60)) "minute"]
                          (< absolute 86400) [(js/Math.round (/ seconds 3600)) "hour"]
                          (< absolute 604800) [(js/Math.round (/ seconds 86400)) "day"]
                          :else [nil nil])]
      (if amount
        (.format (js/Intl.RelativeTimeFormat.
                  (normalize-locale locale) (clj->js {:numeric "auto" :style "short"}))
                 amount unit)
        (.toLocaleDateString date (normalize-locale locale)
                             (clj->js {:year "numeric" :month "short" :day "numeric"}))))
    (catch :default _ (t locale :common.now))))
