(def api-error-codes
  (into #{} (mapcat identity (vals error-groups))))

(def generated-error-messages
  (into {}
        (mapcat (fn [[kind codes]]
                  (map (fn [code] [(keyword (str "error." code)) (get error-copy kind)]) codes))
                error-groups)))

(def messages (merge generated-error-messages base-messages))

