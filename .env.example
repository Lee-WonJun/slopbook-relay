# Local development. Never commit a real value.
SLOPBOOK_ENV=development
SLOPBOOK_PORT=8080
SLOPBOOK_DEV_AUTH=true
SLOPBOOK_STORE=memory
POLICY_CONTACT_EMAIL=
DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/slopbook?user=slopbook&password=local-slopbook-only
SLOPBOOK_DB_POOL_MAX=10
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated
SLOPBOOK_JWKS_CACHE_SECONDS=300
SLOPBOOK_AUTH_REDIRECT_URL=http://localhost:8080/auth/callback
OPENAI_API_KEY=
# The Relay integration always uses Meta. Set the provider to meta for a Meta-only fork.
META_MODEL_API_KEY=
SLOPBOOK_AI_PROVIDER=meta
SLOPBOOK_AI_MODELS=gpt-6-luna
# Standard OpenAI abuse-monitoring retention is allowed; store=false is mandatory.
# For an OpenAI-approved ZDR project, select zdr and confirm it separately.
SLOPBOOK_OPENAI_DATA_POLICY=standard
SLOPBOOK_OPENAI_ZDR_VERIFIED=false
SLOPBOOK_AI_DISCOVERY=false
