{:source-paths ["src" "test"]
 :js-options {:entry-keys ["module" "browser" "main"]}
 :dependencies [[reagent "2.0.1"]
                [re-frame "1.4.7"]]
 :dev-http {8081 "resources/public"}
 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn slopbook.client.app/init}}
        ;; The application's CSP forbids eval. Watch builds use external
        ;; scripts and a manual browser refresh instead of eval-based devtools.
        :devtools {:enabled false
                   :loader-mode :script
                   :after-load slopbook.client.app/reload!}}
  :test {:target :node-test
         :output-to "target/cljs-tests.js"
         :ns-regexp "-test$"
         :autorun true}}}
